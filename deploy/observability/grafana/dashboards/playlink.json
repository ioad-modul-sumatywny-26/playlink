{
 "uid": "playlink",
 "title": "PlayLink regions",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "playlink"
 ],
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Servers",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "CPU busy",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "showPoints": "never"
     },
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "100 - 100 * sum by (region) (rate(host_cpu_seconds_total{mode=\"idle\"}[2m])) / sum by (region) (rate(host_cpu_seconds_total[2m]))",
     "legendFormat": "{{region}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Memory used",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "showPoints": "never"
     },
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "100 * host_memory_used_bytes / host_memory_total_bytes",
     "legendFormat": "{{region}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Network (containers)",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "showPoints": "never"
     },
     "unit": "Bps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (region) (rate(container_network_receive_bytes_total{container_label_com_docker_compose_service!=\"\"}[2m]))",
     "legendFormat": "{{region}} in"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (region) (rate(container_network_transmit_bytes_total{container_label_com_docker_compose_service!=\"\"}[2m]))",
     "legendFormat": "{{region}} out"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Disk used",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "showPoints": "never"
     },
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "100 * host_filesystem_used_ratio{mountpoint=\"/\"}",
     "legendFormat": "{{region}}"
    }
   ]
  },
  {
   "id": 100,
   "type": "row",
   "title": "Containers",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 101,
   "type": "timeseries",
   "title": "Container memory",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (region, container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_service!=\"\"})",
     "legendFormat": "{{region}} {{container_label_com_docker_compose_service}}"
    }
   ]
  },
  {
   "id": 102,
   "type": "timeseries",
   "title": "Container CPU (100% = one core)",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "100 * sum by (region, container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service!=\"\"}[2m]))",
     "legendFormat": "{{region}} {{container_label_com_docker_compose_service}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "row",
   "title": "Application",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Requests per second",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "showPoints": "never"
     },
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (region) (rate(playlink_http_requests_total[2m]))",
     "legendFormat": "{{region}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 12,
    "y": 27,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "showPoints": "never"
     },
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "histogram_quantile(0.95, sum by (le, region) (rate(playlink_http_request_duration_seconds_bucket[2m])))",
     "legendFormat": "{{region}} p95"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "histogram_quantile(0.5, sum by (le, region) (rate(playlink_http_request_duration_seconds_bucket[2m])))",
     "legendFormat": "{{region}} p50"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Errors per second",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "showPoints": "never"
     },
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (region) (rate(playlink_http_requests_total{status=~\"5..\"}[2m]))",
     "legendFormat": "{{region}} 5xx"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (region) (rate(playlink_http_requests_total{status=~\"4..\"}[2m]))",
     "legendFormat": "{{region}} 4xx"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Open WebSockets",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 12,
    "y": 35,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (region, kind) (playlink_ws_connections)",
     "legendFormat": "{{region}} {{kind}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Events per 5 min",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 43,
    "w": 24,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "lineWidth": 1,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum by (event, region) (increase(playlink_events_total[5m]))",
     "legendFormat": "{{region}} {{event}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "row",
   "title": "Logs",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 51,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 13,
   "type": "logs",
   "title": "Errors and warnings",
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "vl"
   },
   "gridPos": {
    "x": 0,
    "y": 52,
    "w": 12,
    "h": 10
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "vl"
     },
     "expr": "level:in(\"ERROR\",\"CRITICAL\",\"WARNING\")",
     "queryType": "instant",
     "maxLines": 200
    }
   ]
  },
  {
   "id": 14,
   "type": "logs",
   "title": "Events (rooms, logins)",
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "vl"
   },
   "gridPos": {
    "x": 12,
    "y": 52,
    "w": 12,
    "h": 10
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "vl"
     },
     "expr": "event:*",
     "queryType": "instant",
     "maxLines": 200
    }
   ]
  }
 ]
}