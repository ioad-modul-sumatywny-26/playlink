# Machine-specific settings and secrets. Copy to deploy/site.env (gitignored).
# Without a domain the stack runs in local mode on localhost with dev secrets.

# Public mode: the region names are derived from this domain:
#   playlink.<domain>          entry host (served by the EU stack)
#   playlink-<region>.<domain> frontend, playlink-<region>-api.<domain> API
PLAYLINK_DOMAIN=
# One Cloudflare Tunnel per region; set the token of each region run here.
TUNNEL_TOKEN_EU=
TUNNEL_TOKEN_US=

# Required in public mode. JWT_SECRET must be the same in every region
# (openssl rand -hex 32). Use hex for POSTGRES_PASSWORD too: it goes into a URL.
JWT_SECRET=
POSTGRES_PASSWORD=
ADMIN_ADDRESSES=

# Only needed while the GHCR packages are private (token with read:packages).
GHCR_USER=
GHCR_TOKEN=

# Pin a release instead of following the latest one (e.g. v0.1.0-rc.1).
PLAYLINK_TAG=

# Central logs and metrics (deploy/observability.sh). Set the same credentials
# on the machine running the stack and on every region; leave empty to turn
# shipping off. Without a domain the regions push to this machine's stack.
OBS_USER=playlink
OBS_PASSWORD=
# Tunnel token of the machine running the stack (public mode only).
TUNNEL_TOKEN_OBS=
# Cloudflare Access team domain in front of Grafana (e.g. myteam.cloudflareaccess.com):
# Access sign-in is then enough, no Grafana password.
CF_ACCESS_TEAM=
# Override the push endpoints (default: playlink-metrics / playlink-logs.<domain>).
OBS_METRICS_URL=
OBS_LOGS_URL=
# Branch the logs/metrics VM follows (deploy/azure-vm.sh ops).
PLAYLINK_OPS_REF=
