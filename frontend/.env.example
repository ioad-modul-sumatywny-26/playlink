# WebSocket base URL for room connections (use ws:// for HTTP or wss:// for HTTPS)
PUBLIC_WS_URL=ws://localhost:8000
PUBLIC_BACKEND_URL=http://localhost:8000

# Region served by this frontend instance.
PUBLIC_REGION=eu

# Entry host that renders the region chooser. Use localhost:3000 only for the
# two-region local harness; the default single-region dev server should not
# hide the app behind the chooser.
PUBLIC_ENTRY_HOST=localhost:9999

# Region list used by the chooser and the manual switch.
PUBLIC_REGION_EU_FRONTEND=http://localhost:3000
PUBLIC_REGION_EU_API=http://localhost:8000
PUBLIC_REGION_EU_WS=ws://localhost:8000
PUBLIC_REGION_US_FRONTEND=http://localhost:3001
PUBLIC_REGION_US_API=http://localhost:8001
PUBLIC_REGION_US_WS=ws://localhost:8001

# SvelteKit adapter-node: use the original Host header and take the scheme
# from X-Forwarded-Proto. Do not set ORIGIN when one frontend container serves
# both the entry and regional hosts.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
