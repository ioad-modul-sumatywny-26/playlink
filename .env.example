# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=playlink
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend Configuration
# Keep this in sync with POSTGRES_* above. Docker Compose env_file values are
# passed literally, so use an explicit URL rather than ${...} placeholders.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/playlink

# Auth Configuration
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-random-secret-min-32
JWT_ALGORITHM=HS256
NONCE_EXPIRATION_MINUTES=5
JWT_EXPIRATION_MINUTES=60

# Deployment / region
REGION=local
APP_VERSION=dev
GIT_SHA=unknown

# Browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Proxies whose CF-Connecting-IP header is trusted (IPs or CIDRs). Loopback only
# by default; deploy/config.env adds the Docker networks for the tunnel.
TRUSTED_PROXY_HOSTS=127.0.0.1,::1

# Admin Configuration
# Comma-separated identity addresses granted admin privileges (case-insensitive).
# Leave empty for no admins. Example: 0xAddress1,0xAddress2
ADMIN_ADDRESSES=

# Rate Limit Configuration
DEFAULT_RATE_LIMIT=10/minute
WS_RATE_LIMIT_MAX_MESSAGES=10
WS_RATE_LIMIT_TIME_WINDOW_SECONDS=10

# --- MCP server and log/metric tools (backend/mcp_server), optional ---
# Region API addresses: set the domain, or PLAYLINK_<REGION>_API per region.
# PLAYLINK_DOMAIN=example.org
# Logs and metrics of all regions (see docs/operations/observability.md). The
# password is OBS_PASSWORD from deploy/site.env. Local stack: http://127.0.0.1:9428 / :8428.
# PLAYLINK_LOGS_URL=https://playlink-logs.example.org
# PLAYLINK_METRICS_URL=https://playlink-metrics.example.org
# PLAYLINK_OBS_USER=playlink
# PLAYLINK_OBS_PASSWORD=
